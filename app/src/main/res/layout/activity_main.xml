<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E3C72">

    <!-- LAYAR PILIH PORTAL AWAL (SISWA VS GURU/PROKTOR) -->
    <LinearLayout
        android:id="@+id/layoutLauncher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <ImageView
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:src="@drawable/ic_launcher"
            android:contentDescription="Logo SMKN 14"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PORTAL PENDIDIKAN &amp; CBT"
            android:textColor="#93C5FD"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMKN 14 KABUPATEN TANGERANG"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih Mode Akses Aplikasi:"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnMasukSiswa"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="🎓 MASUK UJIAN SISWA (MODE TERKUNCI)"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnMasukGuru"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="🛡️ PORTAL GURU / PANITIA / PROKTOR"
                android:backgroundTint="#334155"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Perhatian Siswa: Mode Ujian Siswa otomatis mengunci layar (Screen Pinning), memblokir screenshot, dan mematikan split-screen."
                android:textColor="#64748B"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- LAYAR WEBVIEW UJIAN -->
    <LinearLayout
        android:id="@+id/layoutWebContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#FFFFFF">

        <!-- Bilah Kontrol Atas ExamBrowser -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:background="#0F172A">

            <TextView
                android:id="@+id/tvModeStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔒 MODE UJIAN TERKUNCI"
                android:textColor="#F8FAFC"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRefresh"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Muat Ulang"
                android:textSize="10sp"
                android:backgroundTint="#334155"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnKeluar"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Keluar"
                android:textSize="10sp"
                android:backgroundTint="#DC2626"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>
</LinearLayout>
